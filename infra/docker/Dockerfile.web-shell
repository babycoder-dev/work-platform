FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY modules ./modules

RUN corepack enable && pnpm install --no-frozen-lockfile
RUN pnpm --filter @work/workbench-shell build

FROM nginx:1.27-alpine

COPY infra/nginx/workbench-shell.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/workbench-shell/dist /usr/share/nginx/html

EXPOSE 80
