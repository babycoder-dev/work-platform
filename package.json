{
  "name": "work-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "prepare:dev": "corepack enable && pnpm install",
    "dev:shell": "pnpm --filter @work/workbench-shell dev",
    "dev:platform": "pnpm --filter @work/platform-api start:dev",
    "dev:gateway": "pnpm --filter @work/gateway-api start:dev",
    "dev:im-adapter": "pnpm --filter @work/im-adapter-api start:dev",
    "dev:notification": "pnpm --filter @work/notification-api start:dev",
    "dev:realtime": "pnpm --filter @work/realtime-gateway start:dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "build": "pnpm -r --if-present build",
    "docker:build": "docker compose -f infra/docker-compose.prod.yml build",
    "docker:up": "docker compose -f infra/docker-compose.prod.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.prod.yml down",
    "release:bundle:win": "powershell -ExecutionPolicy Bypass -File scripts/release/create-release-bundle.ps1",
    "release:bundle:linux": "bash scripts/release/create-release-bundle.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint-plugin": "^20.3.0",
    "@nx/js": "^20.3.0",
    "@nx/nest": "^20.3.0",
    "@nx/react": "^20.3.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "nx": "^20.3.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild",
      "nx"
    ]
  }
}
