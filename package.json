{
  "name": "work-platform",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "prepare:dev": "corepack enable && pnpm install",
    "dev:shell": "pnpm --filter @work/workbench-shell dev",
    "dev:platform": "pnpm --filter @work/platform-api start:dev",
    "dev:gateway": "pnpm --filter @work/gateway-api start:dev",
    "dev:im-adapter": "pnpm --filter @work/im-adapter-api start:dev",
    "dev:notification": "pnpm --filter @work/notification-api start:dev",
    "dev:realtime": "pnpm --filter @work/realtime-gateway start:dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:unit && pnpm test:web",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:web": "vitest run --config vitest.web.config.mts",
    "test:db": "vitest run --config vitest.config.mts apps/platform-api/src/repositories/postgres-platform.repository.integration.spec.ts modules/presence/api/src/db/postgres-presence.repository.integration.spec.ts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:e2e:postgres": "vitest run --config vitest.e2e.config.mts apps/platform-api/src/platform-api.postgres.e2e-spec.ts modules/presence/api/src/presence.e2e-spec.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "verify:full": "pnpm verify && pnpm test:db && pnpm test:e2e:postgres",
    "build": "pnpm -r --if-present build",
    "docker:build": "docker compose -f infra/docker-compose.prod.yml build",
    "docker:up": "docker compose -f infra/docker-compose.prod.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.prod.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx apps/platform-api/src/db/migrate.ts",
    "db:migrate:presence": "tsx modules/presence/api/src/db/migrate.ts",
    "db:seed": "tsx apps/platform-api/src/seeds/seed-platform.ts",
    "db:setup": "pnpm db:migrate && pnpm db:migrate:presence && pnpm db:seed",
    "release:bundle:win": "powershell -ExecutionPolicy Bypass -File scripts/release/create-release-bundle.ps1",
    "release:bundle:linux": "bash scripts/release/create-release-bundle.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint-plugin": "^20.3.0",
    "@nx/js": "^20.3.0",
    "@nx/nest": "^20.3.0",
    "@nx/react": "^20.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "nx": "^20.3.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "typescript-language-server": "^5.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild",
      "nx"
    ],
    "overrides": {
      "drizzle-orm": "^0.45.2",
      "qs@>=6.11.1 <=6.15.1": "^6.15.2",
      "koa@<2.16.4": "^2.16.4",
      "tmp@<0.2.6": "^0.2.6",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "esbuild@<0.25.0": "^0.25.0"
    }
  }
}
