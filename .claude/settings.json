{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Write(.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env.local)",
      "Write(**/.env.local)",
      "Edit(**/.env.development)",
      "Write(**/.env.development)",
      "Edit(**/.env.production)",
      "Write(**/.env.production)",
      "Edit(**/.env.prod)",
      "Write(**/.env.prod)",
      "Edit(**/.env.staging)",
      "Write(**/.env.staging)",
      "Edit(**/.env.test)",
      "Write(**/.env.test)",
      "Edit(pnpm-lock.yaml)",
      "Write(pnpm-lock.yaml)",
      "Edit(**/pnpm-lock.yaml)",
      "Write(**/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-on-edit.mjs || true",
            "shell": "bash",
            "timeout": 90,
            "statusMessage": "Formatting edited file (prettier + eslint --fix)…"
          }
        ]
      }
    ]
  }
}
