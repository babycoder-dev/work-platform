{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Write(.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env.local)",
      "Write(**/.env.local)",
      "Edit(**/.env.development)",
      "Write(**/.env.development)",
      "Edit(**/.env.production)",
      "Write(**/.env.production)",
      "Edit(**/.env.prod)",
      "Write(**/.env.prod)",
      "Edit(**/.env.staging)",
      "Write(**/.env.staging)",
      "Edit(**/.env.test)",
      "Write(**/.env.test)",
      "Edit(pnpm-lock.yaml)",
      "Write(pnpm-lock.yaml)",
      "Edit(**/pnpm-lock.yaml)",
      "Write(**/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-module-boundary.mjs",
            "timeout": 10,
            "statusMessage": "Checking module boundary…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/format-on-edit.mjs",
            "timeout": 90,
            "statusMessage": "Formatting edited file (prettier + eslint --fix)…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/load-progress.mjs",
            "timeout": 10,
            "statusMessage": "Loading foundation progress snapshot…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/remind-on-stop.mjs",
            "timeout": 10,
            "statusMessage": "Checking delivery gate reminders…"
          }
        ]
      }
    ]
  }
}
